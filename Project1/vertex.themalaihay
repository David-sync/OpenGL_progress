#version 460 core

layout(location = 0) in vec3 aPos; // vị trí
layout(location = 1) in vec3 vertexColor; // màu

// mở hộp tủ số 5 ra
uniform mat4 MVP;

out vec3 fragmentColor;


void main()
{
	// từng đỉnh của tam giác tại aPos được khai báo là vec3
	gl_Position = MVP * vec4(aPos, 1);

	fragmentColor = vertexColor;
}